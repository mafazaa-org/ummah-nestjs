# Test environment — loaded by test/setup-env.ts (overrides .env). Never point at the dev DB.
NODE_ENV=test
PORT=3001

DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ummah_test?schema=public"

# Firebase is replaced by FakeFirebaseService in tests; values only need to satisfy the env schema.
FIREBASE_PROJECT_ID=ummah-test
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ummah-test.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTEST\n-----END PRIVATE KEY-----\n"

S3_ENDPOINT=https://s3.test.local
S3_REGION=auto
S3_BUCKET=ummah-media-test
S3_ACCESS_KEY_ID=test-access-key
S3_SECRET_ACCESS_KEY=test-secret-key
MEDIA_PUBLIC_BASE_URL=https://media.test.local

CORS_ORIGINS=http://localhost:3000

POST_TEXT_MAX=2000
MEDIA_MAX_PER_POST=4
IMAGE_MAX_BYTES=5242880
VIDEO_MAX_BYTES=52428800
VIDEO_MAX_SECONDS=60
PRESIGN_EXPIRES_SECONDS=300

POST_REPORT_THRESHOLD=7
USER_REPORT_THRESHOLD=15

# High limits so the global throttler never interferes with E2E suites.
THROTTLE_GLOBAL_LIMIT=100000
THROTTLE_TTL_SECONDS=60
THROTTLE_REPORTS_LIMIT=100000
THROTTLE_PRESIGN_LIMIT=100000
