# Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ummah_db?schema=public"

# Firebase Admin
FIREBASE_PROJECT_ID=ummah-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ummah-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Storage (Cloudflare R2 / S3-compatible)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ummah-media-dev
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
MEDIA_PUBLIC_BASE_URL=https://media.ummah.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Business Limits (Locked Defaults from BRD 1.5)
POST_TEXT_MAX=2000
MEDIA_MAX_PER_POST=4
IMAGE_MAX_BYTES=5242880
VIDEO_MAX_BYTES=52428800
VIDEO_MAX_SECONDS=60
PRESIGN_EXPIRES_SECONDS=300

# Moderation Thresholds
POST_REPORT_THRESHOLD=7
USER_REPORT_THRESHOLD=15

# Rate Limiting (Throttling)
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_TTL_SECONDS=60
THROTTLE_REPORTS_LIMIT=5
THROTTLE_PRESIGN_LIMIT=20

# ──────────────────────────────────────────────────────────
# V2 Configuration (Chat, Groups, Calls & Media)
# ──────────────────────────────────────────────────────────

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# LiveKit SFU (WebRTC Audio Calls)
LIVEKIT_URL=wss://livekit.ummah.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Private Chat Storage (S3 / Cloudflare R2)
CHAT_STORAGE_BUCKET=ummah-chat-dev

# APNs (iOS VoIP PushKit for incoming audio calls)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
